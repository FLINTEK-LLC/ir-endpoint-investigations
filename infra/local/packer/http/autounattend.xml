<?xml version="1.0" encoding="utf-8"?>
<!--
  Unattended Windows 11 Pro setup for the local IR golden image - see
  ../golden-image.pkr.hcl's header for why the ISO is user-supplied
  (Microsoft's official download page has no scriptable download, but
  once an ISO is in hand, the install itself can be fully unattended).

  Packer renders this XML template into the floppy's autounattend.xml;
  do not copy the template directly to a floppy. Credentials, computer name,
  Pro setup key, and Windows partition size come from golden-image.pkr.hcl.
  The default key selects Windows 11 Pro; it does not provide a license.
  The ISO must contain an amd64 image named exactly "Windows 11 Pro".

  EFI firmware is explicitly selected in the VMX. Disk 0 is the VM's only
  fixed disk; its contents are wiped. The floppy and optical media do not
  consume fixed-disk IDs. Do not attach additional hard disks during setup.
  WinRM is configured at first logon after the local administrator exists.
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
  <settings pass="windowsPE">
    <component name="Microsoft-Windows-International-Core-WinPE" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <SetupUILanguage>
        <UILanguage>en-US</UILanguage>
      </SetupUILanguage>
      <UILanguage>en-US</UILanguage>
      <SystemLocale>en-US</SystemLocale>
      <UserLocale>en-US</UserLocale>
      <InputLocale>en-US</InputLocale>
    </component>
    <component name="Microsoft-Windows-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <!-- Run in the live WinPE registry, in command Order. Keep these
           before installation; XML element order alone does not schedule
           Setup phases. LabConfig is an undocumented compatibility bypass,
           not a supported hardware configuration or a guarantee for future
           Windows ISOs. It does not emulate missing CPU instructions.
           The existing build reached disk selection with these commands.
      -->
      <RunSynchronous>
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassTPMCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>2</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassSecureBootCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>3</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassRAMCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>4</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassStorageCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>5</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassCPUCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
      </RunSynchronous>
      <!-- GPT layout, paired with firmware=efi: ESP, MSR, Windows, WinRE.
           Recovery is last so Windows can resize it during servicing. -->
      <DiskConfiguration>
        <Disk wcm:action="add">
          <DiskID>0</DiskID>
          <WillWipeDisk>true</WillWipeDisk>
          <CreatePartitions>
            <CreatePartition wcm:action="add">
              <Order>1</Order>
              <Type>EFI</Type>
              <Size>300</Size>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>2</Order>
              <Type>MSR</Type>
              <Size>16</Size>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>3</Order>
              <Type>Primary</Type>
              <Size>${windows_partition_mb}</Size>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>4</Order>
              <Type>Primary</Type>
              <Extend>true</Extend>
            </CreatePartition>
          </CreatePartitions>
          <ModifyPartitions>
            <ModifyPartition wcm:action="add">
              <Order>1</Order>
              <PartitionID>1</PartitionID>
              <Label>System</Label>
              <Format>FAT32</Format>
            </ModifyPartition>
            <!-- The MSR is not formatted or assigned a drive letter. -->
            <ModifyPartition wcm:action="add">
              <Order>2</Order>
              <PartitionID>3</PartitionID>
              <Label>Windows</Label>
              <Format>NTFS</Format>
              <Letter>C</Letter>
            </ModifyPartition>
            <ModifyPartition wcm:action="add">
              <Order>3</Order>
              <PartitionID>4</PartitionID>
              <Label>Recovery</Label>
              <Format>NTFS</Format>
              <TypeID>de94bba4-06d1-4d40-a16a-bfd50179d6ac</TypeID>
            </ModifyPartition>
          </ModifyPartitions>
        </Disk>
        <WillShowUI>OnError</WillShowUI>
      </DiskConfiguration>
      <ImageInstall>
        <OSImage>
          <InstallFrom>
            <!-- Select by image NAME, not an ISO-dependent numeric index.
                 Confirm the name with DISM /Get-WimInfo on install.wim/esd. -->
            <MetaData wcm:action="add">
              <Key>/IMAGE/NAME</Key>
              <Value>Windows 11 Pro</Value>
            </MetaData>
          </InstallFrom>
          <!-- Install to Windows, not the ESP or recovery partition. -->
          <InstallTo>
            <DiskID>0</DiskID>
            <PartitionID>3</PartitionID>
          </InstallTo>
          <WillShowUI>OnError</WillShowUI>
        </OSImage>
      </ImageInstall>
      <UserData>
        <AcceptEula>true</AcceptEula>
        <ProductKey>
          <Key>${product_key}</Key>
          <WillShowUI>OnError</WillShowUI>
        </ProductKey>
      </UserData>
    </component>
  </settings>

  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <ComputerName>${computer_name}</ComputerName>
      <!-- UTC, matching the cloud investigation host's own default
           (infra\scripts\bootstrap-investigation-host.ps1 -TimeZoneId) -
           a forensic workstation's own local clock skew should never be
           the thing you're debugging mid-case. -->
      <TimeZone>UTC</TimeZone>
    </component>
    <component name="Microsoft-Windows-TerminalServices-LocalSessionManager" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <fDenyTSConnections>false</fDenyTSConnections>
    </component>
    <component name="Networking-MPSSVC-Svc" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <!-- RDP only. WinRM gets a separate rule at first logon. -->
      <FirewallGroups>
        <FirewallGroup wcm:action="add" wcm:keyValue="RemoteDesktop">
          <Active>true</Active>
          <Profile>all</Profile>
          <Group>@FirewallAPI.dll,-28752</Group>
        </FirewallGroup>
      </FirewallGroups>
    </component>
  </settings>

  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-International-Core" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <InputLocale>en-US</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <ProtectYourPC>3</ProtectYourPC>
      </OOBE>
      <UserAccounts>
        <LocalAccounts>
          <LocalAccount wcm:action="add">
            <!-- Rendered from the same variables as Packer's communicator. -->
            <Password>
              <Value>${winrm_password}</Value>
              <PlainText>true</PlainText>
            </Password>
            <Group>Administrators</Group>
            <Name>${winrm_username}</Name>
          </LocalAccount>
        </LocalAccounts>
      </UserAccounts>
      <AutoLogon>
        <Enabled>true</Enabled>
        <Username>${winrm_username}</Username>
        <Password>
          <Value>${winrm_password}</Value>
          <PlainText>true</PlainText>
        </Password>
        <LogonCount>1</LogonCount>
      </AutoLogon>
      <FirstLogonCommands>
        <!-- Inline commands only - NOT a script read from the floppy.
             The floppy-script approach (A:\bootstrap-winrm.ps1) failed
             silently in practice: setupact.log showed the command being
             REGISTERED but produced no log file and none of the script's
             side effects (firewall rule, LocalAccountTokenFilterPolicy,
             WSMan Basic auth) ever existed - meaning it registered but
             never actually executed, most likely floppy-device
             availability/timing at the exact FirstLogonCommands execution
             point, which is not guaranteed the way a C:\ path is. Inlining
             removes that whole dependency. Split across multiple short
             commands rather than one long CommandLine (undocumented but
             real-world safer length ceiling), each logging its own
             success/failure to C:\Windows\Temp\packer-winrm.log so a
             future failure is at least visible instead of silent. -->
        <SynchronousCommand wcm:action="add">
          <Order>1</Order>
          <CommandLine>cmd.exe /c echo %DATE% %TIME% start &gt;&gt; C:\Windows\Temp\packer-winrm.log &amp; reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" /v LocalAccountTokenFilterPolicy /t REG_DWORD /d 1 /f &gt;&gt; C:\Windows\Temp\packer-winrm.log 2&gt;&amp;1</CommandLine>
          <Description>Allow local admin remote auth (step 1/4)</Description>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add">
          <Order>2</Order>
          <CommandLine>powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Enable-PSRemoting -SkipNetworkProfileCheck -Force *&gt;&gt; 'C:\Windows\Temp\packer-winrm.log'"</CommandLine>
          <Description>Enable PS Remoting (step 2/4)</Description>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add">
          <Order>3</Order>
          <CommandLine>powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "if (-not (Get-NetFirewallRule -Name PackerWinRM -ErrorAction SilentlyContinue)) { New-NetFirewallRule -Name PackerWinRM -DisplayName 'Packer WinRM HTTP (local subnet)' -Direction Inbound -Action Allow -Protocol TCP -LocalPort 5985 -Profile Any -RemoteAddress LocalSubnet } *&gt;&gt; 'C:\Windows\Temp\packer-winrm.log'"</CommandLine>
          <Description>Open WinRM firewall rule (step 3/4)</Description>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add">
          <Order>4</Order>
          <CommandLine>powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Set-Service WinRM -StartupType Automatic; Set-Item WSMan:\localhost\Service\AllowUnencrypted -Value $true; Set-Item WSMan:\localhost\Service\Auth\Basic -Value $true; Restart-Service WinRM; 'WinRM configured OK' *&gt;&gt; 'C:\Windows\Temp\packer-winrm.log'"</CommandLine>
          <Description>Configure and restart WinRM (step 4/5)</Description>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add">
          <Order>5</Order>
          <!-- LogonCount=1 already limits AutoLogon to this one boot, but
               Windows can still leave the plaintext DefaultPassword value
               behind in the registry - clear it explicitly rather than
               leaving a credential remnant sitting there. Not required for
               WinRM to work, so it runs last/non-blocking. -->
          <CommandLine>powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$k='HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon'; Set-ItemProperty $k -Name AutoLogonCount -Value 0 -ErrorAction SilentlyContinue; Set-ItemProperty $k -Name AutoAdminLogon -Value '0' -ErrorAction SilentlyContinue; Remove-ItemProperty $k -Name DefaultPassword -ErrorAction SilentlyContinue"</CommandLine>
          <Description>Clear AutoLogon credential remnant (step 5/5, non-blocking)</Description>
        </SynchronousCommand>
      </FirstLogonCommands>
    </component>
  </settings>
</unattend>
